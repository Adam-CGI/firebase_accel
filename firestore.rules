rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user email is in allowlist collection
    function isAllowlisted() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    // Allowlist collection - only read access needed
    match /allowlist/{email} {
      allow read: if request.auth != null;
      allow write: if false; // Manage allowlist via Firebase Console
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow read, write: if isAllowlisted();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read, write: if isAllowlisted();
    }

    // Events collection
    match /events/{eventId} {
      allow read, write: if isAllowlisted();
    }

    // People collection
    match /people/{personId} {
      allow read, write: if isAllowlisted();
    }

    // Lock down everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
